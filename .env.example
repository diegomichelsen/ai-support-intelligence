# Modelo das variáveis de ambiente.
# Copie este arquivo para .env e preencha com seus valores reais.
# O .env está no .gitignore e NUNCA deve ser enviado ao GitHub.

# Conexão com o PostgreSQL (Supabase ou local)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=

# (Opcional) Pasta com os JSONs de conversas usada por scripts/import_conversations.py
# Padrão quando vazio: data/synthetic/conversations
CONVERSATIONS_DIR=
